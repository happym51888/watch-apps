# Real credentials. Each app ships a *.example.* file to copy from.
**/Supabase.plist
**/web/config.js

# Generated by xcodegen — regenerate with `xcodegen generate`
*.xcodeproj/
*.xcworkspace/

# Swift / Xcode build output
.build/
.swiftpm/
DerivedData/
build-*.log
*.xcuserstate

# Node, for the web client
node_modules/
dist/
.env
.env.local

# macOS / Windows noise
.DS_Store
Thumbs.db

# Python
__pycache__/
*.pyc
# Only needed to run Volumen's ID3 validator against mutagen locally; CI
# installs it into the runner instead.
.venv/

# Portable PostgreSQL used to run apps/Verba/supabase/test against a real
# server on a machine with no Docker and no admin rights. 323 MB of binaries
# plus a data directory — fetched on demand, see that directory's README.
.tools/

# Local scaffolding from the (failed) attempt to compile Swift on Windows.
# Kept on disk for reference; carries local paths and is of no use to anyone else.
_probe/
*-install.log

# CI logs pulled down for diagnosis, and the throwaway scripts written to read
# them. Useful while chasing a specific failure, worthless once it is fixed.
ci-logs/
screenshots/
.sim-build/
