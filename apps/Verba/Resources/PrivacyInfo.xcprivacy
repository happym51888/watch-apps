<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
	Privacy manifest. Required at submission since spring 2024.

	Verba is the only app in this repo that genuinely collects data, because
	the whole point is that recordings end up in a database you can search
	from a laptop. Declared honestly rather than minimally:

	  * Audio data — the recording itself, uploaded to the app's Supabase
	    storage bucket.
	  * Other user content — the transcript.
	  * Email address — the account the recordings belong to.

	All three are linked to the user, because they are stored under the
	user's id and only that user can read them. None is used for tracking,
	and there is no analytics SDK, no advertising identifier, and no third
	party involved other than the database itself.

	Transcription happens on the device via SFSpeechRecognizer, preferring
	on-device recognition where the locale supports it. Where it does not,
	Apple's speech service performs the recognition; that is Apple's
	processing of the audio, not collection by this app, and the purpose
	string NSSpeechRecognitionUsageDescription in PhoneApp/Info.plist says so.

	NSPrivacyAccessedAPICategoryFileTimestamp is declared because
	FileManager.attributesOfItem(atPath:) is used to read the size of a
	recording (Recorder.byteCount and Inbox.byteCount). 3B52.1 is the correct
	reason: those files are inside the app's own container.
-->
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeAudioData</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeOtherUserContent</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeEmailAddress</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
	</array>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>3B52.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
